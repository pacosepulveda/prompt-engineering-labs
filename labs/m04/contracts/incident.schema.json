{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedIncident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "service",
    "environment",
    "category",
    "severity",
    "affected_users",
    "summary",
    "evidence",
    "suspected_cause",
    "missing_fields",
    "contains_sensitive_data",
    "recommended_action"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^TKT-[0-9]{4}$"
    },
    "service": {
      "type": "string",
      "enum": [
        "identity-api",
        "billing-api",
        "web-portal",
        "unknown"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "staging",
        "development",
        "unknown"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "availability",
        "performance",
        "authentication",
        "data",
        "security",
        "other"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4",
        "UNDETERMINED"
      ]
    },
    "affected_users": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "suspected_cause": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "missing_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "service",
          "environment",
          "affected_users",
          "impact",
          "other"
        ]
      }
    },
    "contains_sensitive_data": {
      "type": "boolean"
    },
    "recommended_action": {
      "type": "string",
      "enum": [
        "request_more_info",
        "open_bug",
        "escalate_security",
        "route_to_service_owner"
      ]
    }
  }
}